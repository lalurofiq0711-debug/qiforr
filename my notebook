$action = $_POST['action'] ?? $_GET['action'] ?? null;

// Download Handler (GET)
if ($action === 'download_file') {
    $attachmentId = !empty($_GET['id']) ? (int)$_GET['id'] : 0;
    if ($attachmentId > 0) {
        $stmt = $pdo->prepare("SELECT original_name, stored_name, file_type FROM attachments WHERE id = ?");
        $stmt->execute([$attachmentId]);
        $file = $stmt->fetch();
        if ($file) {
            $filePath = UPLOAD_DIR . DIRECTORY_SEPARATOR . basename($file['stored_name']);
            if (is_file($filePath) && file_exists($filePath)) {
                $safeName = str_replace(['"', "'", "\r", "\n"], '', $file['original_name']);
                header('Content-Description: File Transfer');
                header('Content-Type: ' . ($file['file_type'] ?: 'application/octet-stream'));
                header('Content-Disposition: attachment; filename="' . $safeName . '"');
                header('Expires: 0');
                header('Cache-Control: must-revalidate');
                header('Pragma: public');
                header('Content-Length: ' . filesize($filePath));
                if (ob_get_level()) ob_end_clean();
                readfile($filePath);
                exit;
            }
        }
    }
    http_response_code(404);
    die('Berkas tidak ditemukan.');
}

// POST Actions Handler
if ($_SERVER['REQUEST_METHOD'] === 'POST' && $action) {
    if (!verify_csrf_token($_POST['csrf_token'] ?? null)) {
        set_flash('error', 'Token keamanan CSRF tidak valid.');
        redirect('index.php');
    }

    // A. Create Note
    if ($action === 'create_note') {
        $title = trim($_POST['title'] ?? '');
        $content = trim($_POST['content'] ?? '');
        $categoryId = !empty($_POST['category_id']) ? (int)$_POST['category_id'] : null;
        $isFavorite = !empty($_POST['is_favorite']) ? 1 : 0;

        if ($title === '') {
            set_flash('error', 'Judul catatan tidak boleh kosong.');
            redirect('index.php?view=new');
        }

        try {
            $stmt = $pdo->prepare("INSERT INTO notes (category_id, title, content, is_favorite, created_at, updated_at) VALUES (?, ?, ?, ?, NOW(), NOW())");
            $stmt->execute([$categoryId, $title, $content, $isFavorite]);
            $newId = (int)$pdo->lastInsertId();
            set_flash('success', 'Catatan baru berhasil dibuat!');
            redirect('index.php?view=note&id=' . $newId);
        } catch (PDOException $e) {
            set_flash('error', 'Gagal membuat catatan: ' . $e->getMessage());
            redirect('index.php');
        }
    }

    // B. Update Note
    if ($action === 'update_note') {
        $id = !empty($_POST['id']) ? (int)$_POST['id'] : 0;
        $title = trim($_POST['title'] ?? '');
        $content = trim($_POST['content'] ?? '');
        $categoryId = !empty($_POST['category_id']) ? (int)$_POST['category_id'] : null;
        $isFavorite = !empty($_POST['is_favorite']) ? 1 : 0;

        if ($id <= 0 || $title === '') {
            set_flash('error', 'Judul catatan tidak boleh kosong.');
            redirect('index.php?view=note&id=' . $id);
        }

        try {
            $stmt = $pdo->prepare("UPDATE notes SET category_id = ?, title = ?, content = ?, is_favorite = ?, updated_at = NOW() WHERE id = ?");
            $stmt->execute([$categoryId, $title, $content, $isFavorite, $id]);
            set_flash('success', 'Catatan berhasil diperbarui!');
            redirect('index.php?view=note&id=' . $id);
        } catch (PDOException $e) {
            set_flash('error', 'Gagal memperbarui catatan: ' . $e->getMessage());
            redirect('index.php?view=note&id=' . $id);
        }
    }

    // C. Delete Note (Beserta lampirannya)
    if ($action === 'delete_note') {
        $id = !empty($_POST['id']) ? (int)$_POST['id'] : 0;
        if ($id > 0) {
            try {
                $attStmt = $pdo->prepare("SELECT stored_name FROM attachments WHERE note_id = ?");
                $attStmt->execute([$id]);
                foreach ($attStmt->fetchAll() as $file) {
                    $p = UPLOAD_DIR . DIRECTORY_SEPARATOR . basename($file['stored_name']);
                    if (is_file($p) && file_exists($p)) @unlink($p);
                }
                $delStmt = $pdo->prepare("DELETE FROM notes WHERE id = ?");
                $delStmt->execute([$id]);
                set_flash('success', 'Catatan beserta semua berkas lampirannya berhasil dihapus.');
            } catch (PDOException $e) {
                set_flash('error', 'Gagal menghapus catatan: ' . $e->getMessage());
            }
        }
        redirect('index.php');
    }

    // D. Upload File Lampiran
    if ($action === 'upload_file') {
        $noteId = !empty($_POST['note_id']) ? (int)$_POST['note_id'] : 0;
        if ($noteId <= 0) {
            set_flash('error', 'Catatan tidak valid.');
            redirect('index.php');
        }

        if (!isset($_FILES['attachment']) || $_FILES['attachment']['error'] !== UPLOAD_ERR_OK) {
            set_flash('error', 'Silakan pilih file yang valid untuk diunggah.');
            redirect('index.php?view=note&id=' . $noteId . '#attachments');
        }

        $file = $_FILES['attachment'];
        $maxSize = 10 * 1024 * 1024; // 10MB
        if ($file['size'] > $maxSize) {
            set_flash('error', 'Ukuran file melebihi batas maksimal 10 MB.');
            redirect('index.php?view=note&id=' . $noteId . '#attachments');
        }

        $allowedExts = ['pdf', 'jpg', 'jpeg', 'png', 'docx'];
        $origName = basename($file['name']);
        $ext = strtolower(pathinfo($origName, PATHINFO_EXTENSION));

        if (!in_array($ext, $allowedExts, true)) {
            set_flash('error', 'Format tidak didukung! Format yang diperbolehkan: PDF, JPG, JPEG, PNG, DOCX.');
            redirect('index.php?view=note&id=' . $noteId . '#attachments');
        }

        // Validasi real MIME
        $finfo = finfo_open(FILEINFO_MIME_TYPE);
        $mime = finfo_file($finfo, $file['tmp_name']);
        finfo_close($finfo);

        $allowedMimes = [
            'pdf'  => ['application/pdf'],
            'jpg'  => ['image/jpeg', 'image/pjpeg'],
            'jpeg' => ['image/jpeg', 'image/pjpeg'],
            'png'  => ['image/png'],
            'docx' => ['application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'application/zip', 'application/octet-stream', 'application/msword']
        ];

        if (!isset($allowedMimes[$ext]) || !in_array($mime, $allowedMimes[$ext], true)) {
            set_flash('error', 'Validasi keamanan MIME type file gagal.');
            redirect('index.php?view=note&id=' . $noteId . '#attachments');
        }

        $storedName = 'doc_' . time() . '_' . bin2hex(random_bytes(10)) . '.' . $ext;
        $dest = UPLOAD_DIR . DIRECTORY_SEPARATOR . $storedName;

        if (move_uploaded_file($file['tmp_name'], $dest)) {
            try {
                $stmt = $pdo->prepare("INSERT INTO attachments (note_id, original_name, stored_name, file_path, file_type, file_size, uploaded_at) VALUES (?, ?, ?, ?, ?, ?, NOW())");
                $stmt->execute([$noteId, $origName, $storedName, 'uploads/' . $storedName, $mime, (int)$file['size']]);
                set_flash('success', 'File "' . $origName . '" berhasil dilampirkan!');
            } catch (PDOException $e) {
                @unlink($dest);
                set_flash('error', 'Gagal mencatat data lampiran: ' . $e->getMessage());
            }
        } else {
            set_flash('error', 'Gagal memindahkan file ke direktori uploads.');
        }

        redirect('index.php?view=note&id=' . $noteId . '#attachments');
    }

    // E. Delete File Attachment
    if ($action === 'delete_file') {
        $attId = !empty($_POST['attachment_id']) ? (int)$_POST['attachment_id'] : 0;
        $noteId = !empty($_POST['note_id']) ? (int)$_POST['note_id'] : 0;

        if ($attId > 0) {
            $stmt = $pdo->prepare("SELECT stored_name, original_name FROM attachments WHERE id = ?");
            $stmt->execute([$attId]);
            $att = $stmt->fetch();
            if ($att) {
                $fp = UPLOAD_DIR . DIRECTORY_SEPARATOR . basename($att['stored_name']);
                if (is_file($fp) && file_exists($fp)) @unlink($fp);
                $del = $pdo->prepare("DELETE FROM attachments WHERE id = ?");
                $del->execute([$attId]);
                set_flash('success', 'Lampiran "' . $att['original_name'] . '" berhasil dihapus.');
            }
        }
        redirect('index.php?view=note&id=' . $noteId . '#attachments');
    }

    // F. Toggle Favorite (Dukung AJAX & Form Biasa)
    if ($action === 'toggle_favorite') {
        $id = !empty($_POST['id']) ? (int)$_POST['id'] : 0;
        $isAjax = (!empty($_SERVER['HTTP_X_REQUESTED_WITH']) && strtolower($_SERVER['HTTP_X_REQUESTED_WITH']) === 'xmlhttprequest');
        if ($id > 0) {
            $pdo->prepare("UPDATE notes SET is_favorite = (1 - is_favorite) WHERE id = ?")->execute([$id]);
            $status = (int)$pdo->query("SELECT is_favorite FROM notes WHERE id = {$id}")->fetchColumn();
            if ($isAjax) {
                header('Content-Type: application/json');
                echo json_encode(['success' => true, 'is_favorite' => $status]);
                exit;
            }
            set_flash('success', $status ? 'Ditambahkan ke Favorit.' : 'Dihapus dari Favorit.');
        }
        $ref = $_SERVER['HTTP_REFERER'] ?? 'index.php';
        header("Location: " . $ref);
        exit;
    }
}

